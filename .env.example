# This file is a convenience reference.
# For local development, prefer copying each app's env file:
# - apps/api/.env.example       -> apps/api/.env
# - apps/simulator/.env.example -> apps/simulator/.env
# - apps/web/.env.example       -> apps/web/.env

# apps/api (Backend)
PORT=3001
FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# apps/simulator
BACKEND_URL=http://localhost:3001
INTERVAL_SECONDS=5

# apps/web (Nuxt)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
